// src/app/features/activities/api/activity_review.ts
import { callBackend } from "@/app/shared/utils/callBackend";
import { maybeThrowAiQuotaError } from "@/app/features/coach/api/coach_athlete_state";

/* ============ shared async_jobs types (minimal) ============ */

type AsyncJobRow = {
  id: number;
  user_id: number;
  job_type: string;
  status: string;
  progress: number;
  error: string | null;
  result: any | null;
  created_at: string;
  started_at: string | null;
  finished_at: string | null;
};

type EnqueueJobResponse = {
  success: boolean;
  job: AsyncJobRow | null;
  note?: string | null;
  detail?: string | null;
  error?: string | null;
};

type RunJobResponse = {
  success: boolean;
  job: AsyncJobRow | null;
  detail?: string | null;
  error?: string | null;
};

/* ============ types ============ */

export type ActivityReviewEnqueueOptions = {
  debug?: boolean;
  model?: string | null;
  /**
   * default: true
   * - keď true, rovno zavoláme /jobs/run/... a vrátime result
   * - keď false, len enqueue a vrátime job
   */
  runNow?: boolean;
};

export type ActivityReviewResult = {
  success: true;
  job: AsyncJobRow;
  /**
   * výsledok z BE: service_review_activity(...)
   * typicky { ok, activity_id, model, review, input?, error? }
   */
  result: any;
};

/**
 * Enqueue (+ optional run) activity_review job for single activity.
 *
 * Backend:
 *  POST /jobs/enqueue/{user_id}   job_type="activity_review"
 *  POST /jobs/run/{user_id}/{job_id}   (optional)
 */
export async function apiEnqueueActivityReview(
  userId: number,
  userUuid: string,
  activityId: number,
  opts: ActivityReviewEnqueueOptions = {}
): Promise<ActivityReviewResult> {
  if (!userId) throw new Error("userId is required in apiEnqueueActivityReview");
  if (!userUuid) throw new Error("userUuid is required in apiEnqueueActivityReview");
  if (!activityId) throw new Error("activityId is required in apiEnqueueActivityReview");

  const payload = {
    activity_id: activityId,
    service: false, // FE call => quota applies, uses user_jwt on backend
    debug: Boolean(opts.debug),
    model: opts.model ?? null,
    save_to_db: true,
  };

  // 1) ENQUEUE
  const enqueuePath = `/jobs/enqueue/${encodeURIComponent(String(userId))}`;

  const enqueueBody = {
    job_type: "activity_review",
    user_uuid: userUuid,
    payload,
    priority: 150,
    max_attempts: 1,
    dedupe_key: `activity_review:${activityId}`,
  };

  let enqueueJson: EnqueueJobResponse;
  try {
    enqueueJson = await callBackend<EnqueueJobResponse>(enqueuePath, {
      method: "POST",
      headers: { "content-type": "application/json" },
      cache: "no-store",
      body: JSON.stringify(enqueueBody),
    });
  } catch (err: any) {
    console.error("[Activities][apiEnqueueActivityReview][enqueue] ERROR", err);
    throw err instanceof Error
      ? err
      : new Error(`Network/BE error (enqueue activity_review): ${String(err)}`);
  }

  if (!enqueueJson?.success || !enqueueJson.job) {
    const msg =
      enqueueJson.detail ||
      enqueueJson.error ||
      enqueueJson.note ||
      "Failed to enqueue activity_review job";
    throw new Error(msg);
  }

  const job = enqueueJson.job;

  // only enqueue (no run)
  if (opts.runNow === false) {
    return {
      success: true,
      job,
      result: job.result,
    };
  }

  // 2) RUN NOW
  const runPath = `/jobs/run/${encodeURIComponent(String(userId))}/${encodeURIComponent(
    String(job.id)
  )}`;

  let runJson: RunJobResponse;
  try {
    runJson = await callBackend<RunJobResponse>(runPath, {
      method: "POST",
      headers: { "content-type": "application/json" },
      cache: "no-store",
    });
  } catch (err: any) {
    console.error("[Activities][apiEnqueueActivityReview][run] ERROR", err);
    throw err instanceof Error
      ? err
      : new Error(`Network/BE error (run activity_review): ${String(err)}`);
  }

  if (!runJson?.success || !runJson.job) {
    const msg =
      runJson.detail ||
      runJson.error ||
      "activity_review job failed or has no job payload";
    throw new Error(msg);
  }

  const result = runJson.job.result;

  // kvóta – ak BE vráti { error: { code: "ai_quota_exceeded", ... } }
  maybeThrowAiQuotaError(result);

  if (!result || typeof result !== "object") {
    throw new Error("activity_review job finished but result payload is empty or invalid");
  }

  return {
    success: true,
    job: runJson.job,
    result,
  };
}